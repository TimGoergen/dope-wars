; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Dope Wars: Omaha"
config/description="Omaha Metro Edition — Pixel 10 Pro XL"
config/version="0.0.0.0001"
config/tags=PackedStringArray("game")
run/main_scene="res://Main.tscn"
config/features=PackedStringArray("4.5", "Mobile")
config/icon="res://art/branding/dope_wars_icon.png"

[audio]

buses/default_bus_layout="res://audio/default_bus_layout.tres"
driver/name="AAudio"
driver/name.Android="AAudio"
driver/name.android="AAudio"
driver/output_latency.android=100
driver/mix_rate.android=44100

[autoload]

Audio="*res://scripts/audio/Audio.gd"

[display]

window/size/viewport_width=1080
window/size/viewport_height=2400
window/size/window_width_override=378
window/size/window_height_override=840
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=1

[dotnet]

project/assembly_name="Dope Wars- Omaha"

[gui]

common/default_scroll_deadzone=30

[rendering]

renderer/rendering_method="mobile"
textures/vram_compression/import_etc2_astc=true
