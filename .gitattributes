# Line-ending policy.
# Anything Godot writes stays LF, anything Windows tooling runs stays CRLF, and binaries are never touched.

* text=auto

# ── Godot text formats — the engine writes these as LF ──────────────────────────
*.gd        text eol=lf
*.tres      text eol=lf
*.tscn      text eol=lf
*.import    text eol=lf
*.godot     text eol=lf
*.cfg       text eol=lf
*.uid       text eol=lf
*.svg       text eol=lf

# ── Documentation ───────────────────────────────────────────────────────────────
*.md        text eol=lf
*.json      text eol=lf
*.py        text eol=lf
*.yml       text eol=lf

# ── Windows-native tooling — these are run by PowerShell / cmd / Inno Setup ─────
*.ps1       text eol=crlf
*.bat       text eol=crlf
*.iss       text eol=crlf

# ── Binary — never normalize, never diff ────────────────────────────────────────
*.png       binary
*.jpg       binary
*.psd       binary
*.wav       binary
*.ogg       binary
*.keystore  binary
*.apk       binary
*.exe       binary
